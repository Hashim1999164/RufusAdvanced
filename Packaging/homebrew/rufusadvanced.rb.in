cask "rufusadvanced" do
  version "@VERSION@"
  sha256 "@SHA256@"

  url "https://github.com/Hashim1999164/RufusAdvanced/releases/download/v#{version}/RufusAdvanced-#{version}-macOS.dmg"
  name "RufusAdvanced"
  desc "Create bootable USB drives for macOS, Windows and Linux (Rufus for macOS)"
  homepage "https://github.com/Hashim1999164/RufusAdvanced"

  livecheck do
    url :url
    strategy :github_latest
  end

  depends_on macos: ">= :ventura"

  app "RufusAdvanced.app"
  binary "#{appdir}/RufusAdvanced.app/Contents/MacOS/rufusadv-helper", target: "rufusadv"

  # The app is ad-hoc signed, not notarized: clear the download quarantine so it opens normally.
  postflight do
    system_command "/usr/bin/xattr",
                   args: ["-dr", "com.apple.quarantine", "#{appdir}/RufusAdvanced.app"]
  end

  zap trash: [
    "~/Library/Caches/RufusAdvanced",
    "~/Library/Logs/RufusAdvanced",
    "~/Library/Preferences/io.github.hashim1999164.rufusadvanced.plist",
    "~/Library/Saved Application State/io.github.hashim1999164.rufusadvanced.savedState",
  ]

  caveats <<~EOS
    RufusAdvanced asks for your password when it writes to a drive (Apple's authopen).
    Downloaded images are kept in ~/Downloads/RufusAdvanced unless you choose another folder.
    Command line: rufusadv help
  EOS
end
